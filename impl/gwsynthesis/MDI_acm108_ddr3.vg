module rgmii_to_gmii (
  gmii_tx_clk,
  rgmii_rxdv_d,
  rgmii_rxd_d,
  gmii_rxdv,
  gmii_rxd
)
;
input gmii_tx_clk;
input rgmii_rxdv_d;
input [3:0] rgmii_rxd_d;
output gmii_rxdv;
output [7:0] gmii_rxd;
wire gmii_rxer;
wire VCC;
wire GND;
  IDDR \rgmii_rxd_i[0].U_IDDR_dq1  (
    .Q0(gmii_rxd[0]),
    .Q1(gmii_rxd[4]),
    .D(rgmii_rxd_d[0]),
    .CLK(gmii_tx_clk) 
);
  IDDR \rgmii_rxd_i[1].U_IDDR_dq1  (
    .Q0(gmii_rxd[1]),
    .Q1(gmii_rxd[5]),
    .D(rgmii_rxd_d[1]),
    .CLK(gmii_tx_clk) 
);
  IDDR \rgmii_rxd_i[2].U_IDDR_dq1  (
    .Q0(gmii_rxd[2]),
    .Q1(gmii_rxd[6]),
    .D(rgmii_rxd_d[2]),
    .CLK(gmii_tx_clk) 
);
  IDDR \rgmii_rxd_i[3].U_IDDR_dq1  (
    .Q0(gmii_rxd[3]),
    .Q1(gmii_rxd[7]),
    .D(rgmii_rxd_d[3]),
    .CLK(gmii_tx_clk) 
);
  IDDR U_IDDR_dv1 (
    .Q0(gmii_rxer),
    .Q1(gmii_rxdv),
    .D(rgmii_rxdv_d),
    .CLK(gmii_tx_clk) 
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* rgmii_to_gmii */
